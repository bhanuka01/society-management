# Copy this file to .env and fill in your credentials.

# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Gemini AI Secret (Supabase Edge Function) ────────────────────────────────
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key_here

# ── Gmail SMTP Secrets (Supabase Edge Secrets) ────────────────────────────────
#   supabase secrets set GMAIL_USER=your_email@gmail.com
#   supabase secrets set GMAIL_APP_PASSWORD=your_16_digit_app_password

# ── Cal.com Interview Scheduling Webhook Secrets ────────────────────────────
#   supabase secrets set CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here
