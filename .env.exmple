# Copy this file to .env and fill in your credentials.

# ── Supabase ────────────────────────────────────────────────────────────────
# Get these from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Gemini AI Secret (Supabase Edge Function) ────────────────────────────────
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key_here

# ── Resend.com Email Integration Secrets (Supabase Edge Secrets) ───────────
# Get API Key from resend.com -> API Keys
#   supabase secrets set RESEND_API_KEY=re_123456789_your_key_here
#   supabase secrets set SOCIETY_FROM_EMAIL="Society Team <onboarding@resend.dev>"

# ── Cal.com Interview Scheduling Webhook Secrets ────────────────────────────
#   supabase secrets set CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here
